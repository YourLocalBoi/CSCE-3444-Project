# -------------------------------------------------
# Unity Git Ignore (Fixed for Proper Syncing)
# -------------------------------------------------

# OS junk
.DS_Store
Thumbs.db

# Unity generated folders
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# JetBrains & Visual Studio files
.vs/
.gradle/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.DotSettings.user

# Unity3D generated crash/metadata files
*.pidb.meta
*.pdb.meta
*.mdb.meta
sysinfo.txt
mono_crash.*

# Builds and packages
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics
crashlytics-build.properties

# TestRunner
InitTestScene*.unity*

# Addressables (auto-generated)
ServerData/
Assets/StreamingAssets/aa*/
Assets/AddressableAssetsData/link.xml*
Assets/Addressables_Temp*/
Assets/AddressableAssetsData/*/*.bin*

# Visual Scripting generated
Assets/Unity.VisualScripting.Generated/**

# -------------------------------------------------
# KEEP THESE — they are ESSENTIAL for proper syncing
# -------------------------------------------------

# ✅ Keep all meta files (critical for asset references)
!*.meta

# ✅ Keep ProjectSettings (Sorting Layers, Tags, etc.)
!ProjectSettings/
!ProjectSettings/**

# ✅ Keep Packages (dependency versions)
!Packages/
!Packages/**

# ✅ Keep Assets folder (your game content)
!Assets/
!Assets/**

# -------------------------------------------------
# Optional: ignore Library cache except meta files
# -------------------------------------------------
Library/**/*
!Library/metadata/
!Library/metadata/**

# -------------------------------------------------
# Notes
# -------------------------------------------------
# - "!" means DO NOT IGNORE
# - Make sure "Visible Meta Files" and "Force Text" are set
#   in Edit → Project Settings → Editor → Version Control.
